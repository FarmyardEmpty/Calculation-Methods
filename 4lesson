import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import root

A_orig = np.array([
    [4, 7, 6, 1],
    [1, 8, 2, 32],
    [-5, 6, -1, -7],
    [6, -6, 2, 6]
], dtype=float)
b_orig = np.array([6, 16, -5, 0], dtype=float)


def system(x):
    return A_orig.dot(x) - b_orig

eps = 0.0001
x0 = [0, 0, 0, 0]

print("=" * 60)
print("ЧАСТЬ 1. Решение через scipy.optimize.root()")
print("=" * 60)
sol_root = root(system, x0)
root_r = sol_root.x
f_val_r = np.linalg.norm(system(root_r))
iters_r = sol_root.nfev

print(f"1. Корень уравнения: x = [{root_r[0]:.4f}, {root_r[1]:.4f}, {root_r[2]:.4f}, {root_r[3]:.4f}]")
print(f"2. Значение функции в точке: f(x) = {f_val_r:.2e}")
print(f"3. Количество итераций: {iters_r}")
print(f"4. Заданная точность: {eps}")
print()

print("=" * 60)
print("ЧАСТЬ 2. Метод Зейделя (с предобуславливанием A^T*A)")
print("=" * 60)

A_trans = A_orig.T @ A_orig
b_trans = A_orig.T @ b_orig


def seidel(A, b, eps, max_iter=1000):
    n = len(b)
    x = np.zeros(n)
    history = [x.copy()]

    for k in range(1, max_iter + 1):
        x_old = x.copy()
        for i in range(n):
            s1 = sum(A[i][j] * x[j] for j in range(i))
            s2 = sum(A[i][j] * x_old[j] for j in range(i + 1, n))
            x[i] = (b[i] - s1 - s2) / A[i][i]
        history.append(x.copy())

        if np.linalg.norm(x - x_old, ord=np.inf) < eps:
            return x, k, np.array(history)

    return x, max_iter, np.array(history)


root_s, iters_s, hist = seidel(A_trans, b_trans, eps)
f_val_s = np.linalg.norm(system(root_s))

print(f"1. Корень уравнения: x = [{root_s[0]:.4f}, {root_s[1]:.4f}, {root_s[2]:.4f}, {root_s[3]:.4f}]")
print(f"2. Значение функции в точке: f(x) = {f_val_s:.2e}")
print(f"3. Количество итераций: {iters_s}")
print(f"4. Заданная точность: {eps}")
print()

plt.figure(figsize=(10, 5))
plt.plot(hist[:, 0], label='x1')
plt.plot(hist[:, 1], label='x2')
plt.plot(hist[:, 2], label='x3')
plt.plot(hist[:, 3], label='x4')
plt.title('Сходимость метода Зейделя')
plt.xlabel('Итерация')
plt.ylabel('Значение переменной')
plt.grid(True)
plt.legend()
plt.show()
