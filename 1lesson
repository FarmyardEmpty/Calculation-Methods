import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import root

def f(x):
    return (6 + x)**3 - 2*x**2 - 8*x - 17

print("=" * 60)
print("ЧАСТЬ 1. Решение через scipy.optimize.root()")
print("=" * 60)

x0 = -8.5
sol = root(f, x0)
root_scipy = sol.x[0]

print(f"Корень уравнения:          x = {root_scipy:.6f}")
print(f"Значение функции в точке:  f(x) = {f(root_scipy):.2e}")
print(f"Количество итераций:       {sol.nfev}")
print(f"Заданная точность:         0.0001")
print(f"Статус:                    {sol.message}")
print()

print("=" * 60)
print("ЧАСТЬ 2. Метод половинного деления")
print("=" * 60)

def bisection(f, a, b, eps=0.0001, max_iter=1000):
    if f(a) * f(b) >= 0:
        raise ValueError("f(a) и f(b) должны иметь разные знаки")
    iter_count = 0
    while (b - a) / 2 > eps and iter_count < max_iter:
        c = (a + b) / 2
        if f(c) == 0:
            break
        if f(a) * f(c) < 0:
            b = c
        else:
            a = c
        iter_count += 1
    root_bis = (a + b) / 2
    return root_bis, iter_count

eps = 0.0001

a, b = -4, -3.5
root_bis, iter_bis = bisection(f, a, b, eps)

print(f"Корень уравнения:          x = {root_bis:.6f}")
print(f"Значение функции в точке:  f(x) = {f(root_bis):.2e}")
print(f"Количество итераций:       {iter_bis}")
print(f"Заданная точность:         {eps}")
print()

print("=" * 60)
print("ЧАСТЬ 3. Сравнение методов")
print("=" * 60)

print(f"{'Метод':<25} {'Корень':<15} {'f(x)':<15} {'Итераций':<10}")
print("-" * 65)
print(f"{'scipy.optimize.root':<25} {root_scipy:<15.6f} {f(root_scipy):<15.2e} {sol.nfev:<10}")
print(f"{'Половинное деление':<25} {root_bis:<15.6f} {f(root_bis):<15.2e} {iter_bis:<10}")
print()

x = np.linspace(-12, 4, 1000)
y = f(x)

plt.figure(figsize=(10, 6))
plt.plot(x, y, label='f(x) = (6 + x)³ − 2x² − 8x − 17', color='blue')
plt.axhline(0, color='black', linewidth=0.8, linestyle='--')
plt.axvline(0, color='black', linewidth=0.8, linestyle='--')

plt.plot(root_scipy, f(root_scipy), 'ko', markersize=10,
         label=f'scipy.root: {root_scipy:.4f}')
plt.plot(root_bis, f(root_bis), 'go', markersize=8,
         label=f'Половинное деление: {root_bis:.4f}')

plt.title('Графическое решение уравнения (6 + x)³ − 2x² − 8x − 17 = 0')
plt.xlabel('x')
plt.ylabel('f(x)')
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()
