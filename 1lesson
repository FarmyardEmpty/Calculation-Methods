import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import root

def f(x):
    return (6 + x)**3 - 2*x**2 - 8*x - 17

def df(x):
    return 3*(6 + x)**2 - 4*x - 8

print("=" * 60)
print("ЧАСТЬ 1. Решение через scipy.optimize.root()")
print("=" * 60)

x0 = -8.5
sol = root(f, x0)
root_scipy = sol.x[0]

print(f"Корень уравнения:          x = {root_scipy:.6f}")
print(f"Значение функции в точке:  f(x) = {f(root_scipy):.2e}")
print(f"Количество итераций:       {sol.nfev}")
print(f"Заданная точность:         0.0001")
print(f"Статус:                    {sol.message}")
print()

print("=" * 60)
print("ЧАСТЬ 2. Метод Ньютона (классический)")
print("=" * 60)

def newton(f, df, x0, eps=0.0001, max_iter=1000):
    x = x0
    iter_count = 0
    for _ in range(max_iter):
        fx = f(x)
        if abs(fx) < eps:
            break
        dfx = df(x)
        if dfx == 0:
            raise ValueError("Производная равна нулю")
        x_new = x - fx / dfx
        if abs(x_new - x) < eps:
            x = x_new
            iter_count += 1
            break
        x = x_new
        iter_count += 1
    return x, iter_count

eps = 0.0001
root_new, iter_new = newton(f, df, -8.5, eps)

print(f"Корень уравнения:          x = {root_new:.6f}")
print(f"Значение функции в точке:  f(x) = {f(root_new):.2e}")
print(f"Количество итераций:       {iter_new}")
print(f"Заданная точность:         {eps}")
print()

print("=" * 60)
print("ЧАСТЬ 3. Сравнение методов")
print("=" * 60)

print(f"{'Метод':<25} {'Корень':<15} {'f(x)':<15} {'Итераций':<10}")
print("-" * 65)
print(f"{'scipy.optimize.root':<25} {root_scipy:<15.6f} {f(root_scipy):<15.2e} {sol.nfev:<10}")
print(f"{'Ньютон':<25} {root_new:<15.6f} {f(root_new):<15.2e} {iter_new:<10}")
print()

x = np.linspace(-12, 4, 1000)
y = f(x)

plt.figure(figsize=(10, 6))
plt.plot(x, y, label='f(x) = (6 + x)³ − 2x² − 8x − 17', color='blue')
plt.axhline(0, color='black', linewidth=0.8, linestyle='--')
plt.axvline(0, color='black', linewidth=0.8, linestyle='--')

plt.plot(root_scipy, f(root_scipy), 'ko', markersize=10, label=f'scipy.root: {root_scipy:.4f}')
plt.plot(root_new, f(root_new), 'go', markersize=8, label=f'Ньютон: {root_new:.4f}')

plt.title('Графическое решение уравнения')
plt.xlabel('x')
plt.ylabel('f(x)')
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()
