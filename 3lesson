import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import fsolve

def F(x):
    x1, x2, x3, x4 = x
    return [
        3*x1 + 1*x2 + 1*x3 + 7*x4 - 8,
        1*x1 + 8*x2 + 6*x3 + 4*x4 - 4,
        -5*x1 + 6*x2 - 1*x3 - 7*x4 + 5,
        1*x1 - 6*x2 + 8*x3 + 6*x4 - 3
    ]

def J(x):
    return np.array([
        [3, 1, 1, 7],
        [1, 8, 6, 4],
        [-5, 6, -1, -7],
        [1, -6, 8, 6]
    ], dtype=float)

eps = 0.0001
x0 = [0, 0, 0, 0]

# --- ЧАСТЬ 1: fsolve ---
print("=" * 60)
print("ЧАСТЬ 1. Решение через scipy.optimize.fsolve()")
print("=" * 60)
sol_fsolve, info, ier, msg = fsolve(F, x0, full_output=True)
root_f = sol_fsolve
f_val = np.linalg.norm(F(root_f)) # Невязка (норма вектора)
iters_f = info['nfev']

print(f"1. Корень уравнения: x = [{root_f[0]:.4f}, {root_f[1]:.4f}, {root_f[2]:.4f}, {root_f[3]:.4f}]")
print(f"2. Значение функции в точке: f(x) = {f_val:.2e}")
print(f"3. Количество итераций: {iters_f}")
print(f"4. Заданная точность: {eps}")
print()

# --- ЧАСТЬ 2: Метод Ньютона ---
print("=" * 60)
print("ЧАСТЬ 2. Классический метод Ньютона")
print("=" * 60)

def newton_method(F, J, x0, eps, max_iter=50):
    x = np.array(x0, dtype=float)
    history = [x.copy()]
    
    for k in range(1, max_iter + 1):
        Fx = np.array(F(x))
        if np.linalg.norm(Fx) < eps:
            return x, k - 1, np.array(history) # Возвращаем k-1 итераций, если сошлось сразу
        Jx = J(x)
        dx = np.linalg.solve(Jx, -Fx)
        x = x + dx
        history.append(x.copy())
        
    return x, max_iter, np.array(history)

root_n, iters_n, hist = newton_method(F, J, x0, eps)
f_val_n = np.linalg.norm(F(root_n))

print(f"1. Корень уравнения: x = [{root_n[0]:.4f}, {root_n[1]:.4f}, {root_n[2]:.4f}, {root_n[3]:.4f}]")
print(f"2. Значение функции в точке: f(x) = {f_val_n:.2e}")
print(f"3. Количество итераций: {iters_n}")
print(f"4. Заданная точность: {eps}")
print()

# --- ГРАФИК ---
plt.figure(figsize=(10, 5))
plt.plot(hist[:, 0], 'o-', label='x1')
plt.plot(hist[:, 1], 's-', label='x2')
plt.plot(hist[:, 2], '^-', label='x3')
plt.plot(hist[:, 3], 'd-', label='x4')
plt.title('Сходимость метода Ньютона')
plt.xlabel('Итерация')
plt.ylabel('Значение переменной')
plt.grid(True)
plt.legend()
plt.show()
