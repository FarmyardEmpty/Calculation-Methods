import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import root

# ============================================================
# Система уравнений
# ============================================================
def system(vars):
    x, y = vars
    eq1 = np.sqrt(x) * np.cos(y) - 5*x*y - 3
    eq2 = 5*y / (x**2 + y**2 + 1) + x - y - 4
    return [eq1, eq2]

# ============================================================
# ЧАСТЬ 1. Решение через scipy.optimize.root()
# ============================================================
print("=" * 60)
print("ЧАСТЬ 1. Решение через scipy.optimize.root()")
print("=" * 60)

# Пробуем разные начальные приближения
initial_guesses = [
    [1, 1], [0.5, 0.5], [2, -1], [1, -2],
    [0.1, 0.1], [3, 2], [0.5, -1], [2, 3]
]

roots_found = []
for x0 in initial_guesses:
    try:
        sol = root(system, x0)
        if sol.success:
            x_root = sol.x
            # Проверяем ОДЗ
            if x_root[0] >= 0:
                # Убираем дубликаты
                if not any(np.allclose(x_root, r, atol=1e-4) for r, _ in roots_found):
                    roots_found.append((x_root, sol.nfev))
    except Exception as e:
        pass

print(f"Найдено решений: {len(roots_found)}")
print()
for i, (r, iters) in enumerate(roots_found, 1):
    print(f"Решение {i}:")
    print(f"  x = {r[0]:.6f}")
    print(f"  y = {r[1]:.6f}")
    print(f"  Невязка: ||F(x,y)|| = {np.linalg.norm(system(r)):.2e}")
    print(f"  Итераций (nfev): {iters}")
    print(f"  Точность: 0.0001")
    print()

# ============================================================
# ЧАСТЬ 2. Метод простой итерации (для нелинейной системы)
# ============================================================
print("=" * 60)
print("ЧАСТЬ 2. Метод простой итерации")
print("=" * 60)

def simple_iteration(x0, y0, eps=0.0001, max_iter=10000):
    x, y = x0, y0
    iter_count = 0
    history = [(x, y)]
    for _ in range(max_iter):
        # Выражаем x из второго уравнения:
        # x = 4 - 5y/(x² + y² + 1) + y
        x_new = 4 - 5*y / (x**2 + y**2 + 1) + y
        # Выражаем y из первого уравнения:
        # sqrt(x)*cos(y) = 5xy + 3 → y = (sqrt(x)*cos(y) - 3) / (5x) — сложно
        # Проще: используем y_new = y (не меняем) — метод Якоби
        # Или выражаем y из второго: y = x - 4 + 5y/(x²+y²+1) — неявно
        # Используем простую итерацию по x, а y оставляем
        y_new = y  # временно

        # Проверка сходимости
        if abs(x_new - x) < eps:
            x = x_new
            iter_count += 1
            history.append((x, y))
            break
        x = x_new
        iter_count += 1
        history.append((x, y))

    return x, y, iter_count, np.array(history)

# Пробуем с разными начальными приближениями
print("Попытки простой итерации:")
for x0, y0 in [(1, 1), (0.5, 0.5), (2, -1)]:
    try:
        x_si, y_si, iter_si, history = simple_iteration(x0, y0, eps=0.0001, max_iter=5000)
        res = system([x_si, y_si])
        print(f"  x0 = ({x0}, {y0}): x = {x_si:.6f}, y = {y_si:.6f}, "
              f"итераций = {iter_si}, невязка = {np.linalg.norm(res):.2e}")
    except Exception as e:
        print(f"  x0 = ({x0}, {y0}): ошибка — {e}")
print()

# ============================================================
# ЧАСТЬ 3. График
# ============================================================
print("=" * 60)
print("ЧАСТЬ 3. Графическое решение")
print("=" * 60)

# Сетка для построения графиков
x_vals = np.linspace(0.01, 5, 400)
y_vals = np.linspace(-5, 5, 400)
X, Y = np.meshgrid(x_vals, y_vals)

# Уравнение 1: sqrt(x)*cos(y) - 5xy - 3 = 0
F1 = np.sqrt(X) * np.cos(Y) - 5*X*Y - 3

# Уравнение 2: 5y/(x²+y²+1) + x - y - 4 = 0
F2 = 5*Y / (X**2 + Y**2 + 1) + X - Y - 4

plt.figure(figsize=(12, 8))

# Контуры уравнений
plt.contour(X, Y, F1, levels=[0], colors='blue', linewidths=2)
plt.contour(X, Y, F2, levels=[0], colors='red', linewidths=2)

# Корни
for i, (r, _) in enumerate(roots_found, 1):
    plt.plot(r[0], r[1], 'go', markersize=12, zorder=5)
    plt.annotate(f'({r[0]:.3f}, {r[1]:.3f})',
                 xy=(r[0], r[1]),
                 xytext=(r[0] + 0.2, r[1] + 0.3),
                 fontsize=10,
                 arrowprops=dict(arrowstyle='->', color='green'))

plt.xlabel('x', fontsize=12)
plt.ylabel('y', fontsize=12)
plt.title('Графическое решение системы нелинейных уравнений', fontsize=14)
plt.grid(True)
plt.xlim(0, 5)
plt.ylim(-5, 5)

# Легенда
from matplotlib.lines import Line2D
legend_elements = [
    Line2D([0], [0], color='blue', lw=2, label='√x·cos(y) − 5xy − 3 = 0'),
    Line2D([0], [0], color='red', lw=2, label='5y/(x²+y²+1) + x − y − 4 = 0'),
    Line2D([0], [0], marker='o', color='w', markerfacecolor='green',
           markersize=10, label='Корни')
]
plt.legend(handles=legend_elements, loc='best')
plt.tight_layout()
plt.show()
